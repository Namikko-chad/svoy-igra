# ==== HTTP server ====
SERVER_HOST=0.0.0.0
SERVER_PORT=3050
# Display name answered to LAN discovery probes and shown by /api/info.
SERVER_NAME=Своя игра

# ==== Storage (no database: packs are SQLite files, games are JSON files) ====
# Holds packs/<id>/{pack.sqlite,media/} and games/<id>.json.
DATA_DIR=./data
# Upload limit for .dub archives and media files, MiB (also the unpacked-pack limit).
MAX_UPLOAD_MB=1024

# ==== Games ====
# A game with nobody connected for this many minutes is deleted.
GAME_IDLE_MINUTES=60
# Upper bound of simultaneous games.
MAX_GAMES=100

# ==== Links ====
# Public address of the web client used in share links (e.g. https://igra.example.com).
# Empty: the address of the page / app that created the game.
WEB_URL=
# Android App Links: /.well-known/assetlinks.json for the mobile app. Empty
# fingerprints: 404, and Android asks which app opens the link.
ANDROID_PACKAGE=dev.svoyigra.mobile
ANDROID_CERT_SHA256=

# ==== Optional ====
# Serve a built frontend (e.g. ../frontend/dist) from the same port. Empty: API only.
STATIC_DIR=
# UDP port for LAN discovery (mobile/TV find the server). 0 disables it.
DISCOVERY_PORT=3051
# Comma-separated allowed browser origins, or * for any.
CORS_ORIGINS=*
# debug | info | warn | error
LOG_LEVEL=info
